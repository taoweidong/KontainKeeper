__pycache__/
*.py[cod]
.pytest_cache/
*.db
*.db-wal
*.db-shm
dist/
# 本地运行数据目录（SQLite 运行库、自更新资产等），非源码
data/
# 仅忽略 Python 构建目录，web/build/ 是 pure-admin 前端的构建辅助源码，必须入库
agent/build/
*.egg-info/
.venv/
# WSL 在仓库根跑 `python3 -m venv` 失败时落下的残留（曾出现 bin/python → WSL、lib64、pyvenv.cfg）
bin/
lib64
pyvenv.cfg
kk-agent.log*
# Agent 自更新：上传/缓存的二进制与临时文件（默认 KK_AGENT_BIN_DIR=agent_assets）
agent_assets/
*.prev
.kk-agent.update.*
# 凭据：Mosquitto 密码文件与本地 .env 严禁入库（代码审查 P0-2，仓库公开）
deploy/mosquitto/passwordfile
.env
# 本地工作日志（审查会话记忆），非项目产物
.workbuddy/
.trae/
.zcode/
.codegraph/
# 编码工具自己的规划/会话目录与技能锁文件（QR-P6 仓库卫生：工具态不进产品仓库）
.stepcode/
.codeartsdoer/
skills-lock.json
# pnpm 本地 store 实验遗留（web/.npmrc 已不含 store-dir，根目录不该出现缓存壳）
.pnpm-store/
# eslint 的增量缓存：lint:eslint 带 --cache，谁跑一次谁就多一个未跟踪文件
.eslintcache
# CI 产物与构建缓存（Jenkins 流水线：测试报告、uv/pip 缓存、节点内的 uv 与构建 venv）
reports/
.ci-cache/
.ci-tools/
# 离线镜像 tar（deploy/offline/pack.sh 产出，动辄数 GB，严禁入库）
deploy/offline/images/*.tar.gz
deploy/offline/images/SHA256SUMS

# 本地三端运行时产物（pid/log，由会话托管，严禁入库）
service/
