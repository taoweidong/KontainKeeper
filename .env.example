# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交。
# 使用方法：docker compose -f docker-compose.prod.yml --env-file .env up --build

# ---- Mosquitto ----
# 服务端桥接账号（与 deploy/mosquitto/passwordfile 中 kk-server 的口令一致）
KK_MQTT_USERNAME=kk-server
KK_MQTT_PASSWORD=

# ---- 服务端 ----
# 逗号分隔的 Agent 接入 token；每台主机建议独立一个（生产禁止出现 dev-token）
KK_AGENT_TOKENS=
# 管理员口令（生产禁止使用 admin）
KK_ADMIN_USER=admin
KK_ADMIN_PASS=

# 可选：主题前缀（须与 Agent 的 KK_TOPIC_PREFIX 一致）
KK_TOPIC_PREFIX=kk/v1
