# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交。
# 使用方法：docker compose -f docker-compose.prod.yml --env-file .env up --build

# ---- 服务端 ----
# Agent 接入白名单（v3：替代原 token 认证）：逗号分隔 IP / CIDR，
# 只有名单内 IP 的 Agent 才能上报数据，其余全部拒绝并审计。
# 如：10.0.0.0/24,192.168.1.5
KK_AGENT_IPS=

# 管理员口令（生产禁止使用 admin/admin123）
KK_ADMIN_USER=admin
KK_ADMIN_PASS=

# 可选：主题前缀（须与 Agent 的 KK_TOPIC_PREFIX 一致）
KK_TOPIC_PREFIX=kk/v1
